---
import StatusBadge from '@hfanieng/ui/status-badge';
const data = Astro.locals.starlightRoute.entry.data;
const title = String(data.displayTitle || data.title || '').trim();
const isEvent = Astro.locals.starlightRoute.id.startsWith('events/');
const statuses = {
  scheduled: { label: 'Geplant', tone: 'neutral' },
  postponed: { label: 'Verschoben', tone: 'warning' },
  cancelled: { label: 'Abgesagt', tone: 'error' },
  completed: { label: 'Vergangen', tone: 'neutral' },
  TBA: { label: 'Status offen', tone: 'neutral' },
} as const;
const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date());
const eventDate = data.pubDate?.toISOString().slice(0, 10);
const showStatus = isEvent && data.status
  && (data.status !== 'scheduled' || (eventDate !== undefined && eventDate > today));
const status = showStatus && data.status ? statuses[data.status] : undefined;
---

<header class="event-page-title">
  <h1 id="_top">{title}</h1>
  {status && <StatusBadge {...status} />}
</header>

<style>
  @layer starlight.core {
    .event-page-title {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .event-page-title h1 {
      margin: 0;
      font-size: var(--font-size-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

  }
</style>
