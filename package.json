{
  "name": "mysteryland",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/social/check-public-build.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck:ts": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "test:seo": "node --test tests/seo/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "verify": "npm run check && npm run typecheck:ts && npm test && npm run build",
    "deploy:ssh": "node scripts/deploy/ssh-deploy-astro.ts",
    "postinstall": "patch-package",
    "event": "node src/scripts/event/cli.ts",
    "event:setlist": "node src/scripts/event/setlist.ts",
    "event:media": "node src/scripts/event/media.ts",
    "event:gallery": "node src/scripts/event/gallery.ts",
    "event:og": "node src/scripts/event/og.ts",
    "event:seo": "node src/scripts/event/seo.ts",
    "event:outbox": "node src/scripts/event/outbox.ts",
    "event:social": "node src/scripts/event/social.ts",
    "event:album": "node src/scripts/event/album.ts",
    "event:covers": "node src/scripts/event/localize-album-covers.ts",
    "artist:sync": "node src/scripts/artist/sync.ts",
    "script:github:create-labels": "node src/scripts/github/create-label.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/starlight": "^0.43.2",
    "@hfanieng/ui": "file:vendor/hfanieng-ui-0.7.8.tgz",
    "@iconify-json/lucide": "^1.2.111",
    "astro": "^7.4.13",
    "astro-icon": "^1.1.5",
    "glightbox": "^3.3.1",
    "preact": "^10.29.7",
    "sharp": "^0.34.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  }
}
